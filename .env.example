NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://pos_app:change-me@localhost:5432/restaurant_pos
SESSION_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-a-separate-random-secret

# Payment provider selection: "stripe" or "manual"
# "manual" is a fail-closed adapter that cannot start checkouts and refuses all webhooks
PAYMENT_PROVIDER=manual

# Stripe credentials (required only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Billing webhook behavior
BILLING_GRACE_DAYS=7
BILLING_WEBHOOK_MAX_ATTEMPTS=8
BILLING_WEBHOOK_LEASE_SECONDS=300

# Object storage (future use)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=