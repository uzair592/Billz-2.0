# =============================================================================
# Billz 2.0 — environment configuration
#
# Copy this file to .env and fill in real values. Never commit a real .env.
# In production every value must be a real secret; placeholder values are
# rejected at startup (fail closed).
# =============================================================================

# Runtime environment: development | test | production
# Production enforces HTTPS origins, rejects placeholder secrets, and
# refuses localhost trusted origins.
NODE_ENV=development

# Bind address for the API server.
HOST=0.0.0.0

# Port the API server listens on.
PORT=3000

# PostgreSQL connection string. Never commit a real password here.
# For managed PostgreSQL that requires TLS, also set DATABASE_SSL_MODE.
DATABASE_URL=postgresql://pos_app:change-me@localhost:5432/restaurant_pos

# TLS mode for the PostgreSQL connection. Common values:
#   disable  - no TLS (local development only)
#   require  - TLS, skip CA verification
#   verify-full - TLS, verify the server certificate against DATABASE_SSL_CA
# Leave unset to disable TLS (suitable for a local socket/localhost only).
DATABASE_SSL_MODE=

# Optional CA certificate (PEM) used when DATABASE_SSL_MODE=verify-full.
DATABASE_SSL_CA=

# Connection pool tuning (optional).
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Comma-separated exact list of trusted browser origins (no wildcards).
# Example: https://pos.example.com,https://admin.example.com
# In production every origin must be HTTPS and must not be localhost.
# (TRUSTED_ORIGIN is still accepted as a single-origin shorthand.)
TRUSTED_ORIGINS=http://localhost:3000

# Authentication / session secrets. Use at least 32 random bytes each,
# generated independently. They must differ from each other.
SESSION_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_PEPPER=replace-with-a-separate-random-secret

# Payment provider selection: "stripe" or "manual".
# "manual" is a fail-closed adapter that cannot start checkouts and
# refuses all webhooks. Use it only for development/testing.
PAYMENT_PROVIDER=manual

# Stripe credentials (required only when PAYMENT_PROVIDER=stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Billing webhook behavior.
BILLING_GRACE_DAYS=7
BILLING_WEBHOOK_MAX_ATTEMPTS=8
BILLING_WEBHOOK_LEASE_SECONDS=300

# Structured log level: debug | info | warn | error
LOG_LEVEL=warn

# Reverse-proxy handling. Set to "true" ONLY when a trusted reverse
# proxy (nginx, Cloudflare, Railway, Render) terminates TLS in front of
# the container. When enabled, client IPs are read from forwarded
# headers. Leave "false" when the container is exposed directly.
TRUST_PROXY=false

# Migration runner: directory containing the ordered *.sql migrations.
# Used by the release command, not by the application at startup.
MIGRATIONS_DIR=database/migrations
