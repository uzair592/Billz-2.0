{
  "name": "bite-tech-pos-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Characterization tests and migration scaffold for the Bite Tech restaurant POS SaaS conversion.",
  "scripts": {
    "test": "node --test",
    "test:legacy": "node --test tests/legacy-*.test.mjs tests/money-engine.test.mjs tests/order-status.test.mjs",
    "validate:compose": "docker compose -f compose.validation.yaml config",
    "validate:database": "docker compose -f compose.validation.yaml up --abort-on-container-exit --exit-code-from migrations"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
