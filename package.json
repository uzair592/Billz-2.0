{
  "name": "bite-tech-pos-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Characterization tests and migration scaffold for the Bite Tech restaurant POS SaaS conversion.",
  "scripts": {
    "test": "node tests/run-unit-tests.mjs",
    "test:postgres": "node tests/run-postgres-tests.mjs",
    "test:legacy": "node --test tests/legacy-*.test.mjs tests/money-engine.test.mjs tests/order-status.test.mjs",
    "test:integration": "node tests/helpers/check-db.mjs && node --test tests/billing-postgres.test.mjs && node --test tests/refund-sales-report-postgres.test.mjs",
    "test:fullstack": "node --test tests/saas-core-fullstack.test.mjs",
    "test:browser:saas-core": "npx playwright test --config=playwright.saas-core.config.mjs",
    "validate": "npm run validate:compose && npm run validate:database",
    "validate:compose": "docker compose -f compose.validation.yaml config",
    "validate:database": "docker compose -f compose.validation.yaml up --abort-on-container-exit --exit-code-from migrations",
    "start": "node src/server/main.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
